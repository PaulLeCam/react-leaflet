              class="leaflet-tile"
              src="http://localhost/not-nested"
              style="width: 256px; height: 256px; transform: translate(-256px,0px);"
            />
            <img
              alt=""
              class="leaflet-tile"
              src="http://localhost/not-nested"
              style="width: 256px; height: 256px; transform: translate(0px,0px);"
            />
          </div>
        </div>
      </div>
    </div>
    <div
      class="leaflet-control-container"
    >
      <div
        class="leaflet-top leaflet-left"
      >
        <div
          class="leaflet-control-zoom leaflet-bar leaflet-control"
        >
          <a
            aria-disabled="false"
            aria-label="Zoom in"
            class="leaflet-control-zoom-in"
            href="#"
            role="button"
            title="Zoom in"
