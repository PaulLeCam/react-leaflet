{
  "name": "react-leaflet-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "lint": "biome check --write ./example ./packages",
    "lint:ci": "biome ci ./example ./packages",
    "test": "pnpm run -r test:unit",
    "build": "turbo run build:clean && pnpm run -r build:types && turbo run build:js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@skypack/package-check": "^0.2.2",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/warning": "^3.0.4",
    "del-cli": "^8.0.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "leaflet": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "jest": {
    "projects": [
      "<rootDir>/packages/*"
    ]
  }
}
