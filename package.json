{
  "name": "react-leaflet-repository",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "lint": "biome check --write ./example ./packages",
    "lint:ci": "biome ci ./example ./packages",
    "test": "pnpm run -r test:unit",
    "build": "turbo run build:clean && pnpm run -r build:types && turbo run build:js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.3",
    "@skypack/package-check": "^0.2.2",
    "@swc/cli": "^0.7.8",
    "@swc/core": "^1.13.3",
    "@swc/jest": "^0.2.39",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.20",
    "@types/warning": "^3.0.0",
    "del-cli": "^6.0.0",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "leaflet": "^1.9.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "turbo": "^2.5.5",
    "typescript": "^5.9.2"
  },
  "jest": {
    "projects": [
      "<rootDir>/packages/*"
    ]
  }
}
